# Supabase (https://supabase.com/dashboard/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App URL (used in AI Guide & links; on Vercel VERCEL_PROJECT_PRODUCTION_URL is used as fallback)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Ed25519 Keys (run: npm run keys:generate)
# Private key: base64 of 64-byte libsodium-compatible secret key (seed + pubkey) or 32-byte seed
# Public key: base64 of 32-byte Ed25519 public key (embedded in client apps)
LICENSE_PRIVATE_KEY=
LICENSE_PUBLIC_KEY=

# Licensing defaults
LICENSE_KEY_PREFIX=DEI
LICENSE_OFFLINE_GRACE_DAYS=14
LICENSE_PORTAL_RESET_DAYS=7
LICENSE_TELEMETRY_RETENTION_DAYS=180

# Signed cookie secret for Customer Portal (/support) - falls back to SUPABASE_SERVICE_ROLE_KEY if unset
PORTAL_SESSION_SECRET=

# Release Storage: "supabase" (default, uses private "releases" bucket) or "s3" (Arvan Cloud / S3-compatible)
LICENSE_STORAGE=supabase
LICENSE_STORAGE_BUCKET=releases
LICENSE_S3_URL_TTL=10

# Optional S3-compatible storage (Arvan Cloud) when LICENSE_STORAGE=s3
LICENSE_S3_KEY=
LICENSE_S3_SECRET=
LICENSE_S3_BUCKET=
LICENSE_S3_REGION=ir-thr-at1
LICENSE_S3_ENDPOINT=https://s3.ir-thr-at1.arvanstorage.ir
LICENSE_S3_PATH_STYLE=true
